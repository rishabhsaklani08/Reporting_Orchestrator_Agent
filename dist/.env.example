# ==============================================================================
# Workday Reporting Orchestration Agent — Configuration Template (.env)
# ==============================================================================
# Instructions:
# 1. Rename this file to ".env" (remove the ".example" extension).
# 2. Place this ".env" file in the same folder as "Reporting_Orchestrator.exe".
# 3. Enter your API keys and configuration values below.
# 4. Save and launch the application.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Search & Report Discovery Configuration
# ------------------------------------------------------------------------------
# Your API key from Groq (https://console.groq.com) or OpenAI (https://platform.openai.com)
OPENAI_API_KEY=your_api_key_here

# Base URL for the OpenAI-compatible API endpoint
# For Groq:   https://api.groq.com/openai/v1
# For OpenAI: https://api.openai.com/v1
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Model name to use for AI report scoring and re-ranking
MODEL_NAME=qwen/qwen3.8-27b

# Search tuning parameters (defaults recommended)
BM25_TOP_N=15
LLM_TOP_K=5

# ------------------------------------------------------------------------------
# 2. Workday RaaS Catalog Sync (Optional)
# ------------------------------------------------------------------------------
# URL and Integration System User (ISU) credentials to sync the catalog from Workday
WORKDAY_RAAS_URL=https://<workday_host>/ccx/service/customreport2/<tenant>/<owner>/All_Custom_Reports_Enabled_as_RAAS?&format=json
WORKDAY_ISU_USERNAME=your_isu_username
WORKDAY_ISU_PASSWORD=your_isu_password

# ------------------------------------------------------------------------------
# 3. Workday Tenant URLs (change these to point to a different tenant)
# ------------------------------------------------------------------------------
# Source tenant login page (DPT3 by default)
WD_TENANT_LOGIN_URL=https://wd2-impl-identity.workday.com/wday/authgwy/accenture_dpt3/upc/login
# Customer Central login page
WD_CC_LOGIN_URL=https://wd2-impl-identity.workday.com/wday/authgwy/accenture_ptcc/upc/login?redirect=n

# ------------------------------------------------------------------------------
# 4. Workday Login Credentials (Optional)
# ------------------------------------------------------------------------------
# If omitted here, you can enter them securely in the Web UI when launching workflows.
WD_USER=
WD_PASS=
